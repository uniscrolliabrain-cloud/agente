  subject: z.string().max(500),
  note: z.string().max(10000).default(""),
  opportunityId: z.string().max(200).optional(),
  contactId: z.string().max(200).optional(),
  companyId: z.string().max(200).optional(),
  owner: z.string().max(200).optional(),
