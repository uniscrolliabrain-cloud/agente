          }
        },
      }),
      defineTool({
        name: "create_goal",
        description: "Save an outcome and milestones requested by the user",
        parameters: goalInputSchema,
        execute: async (args) =>
          this.service.createGoal(
            this.owner,
            args,
            createHash("sha256").update(key("goal", args)).digest("hex"),
          ),
      }),
      defineTool({
        name: "watch_page",
