        x2={end.x - 0.5}
        y1={end.y}
        y2={h}
        stroke="#16b364"
        strokeWidth="1.5"
        vectorEffect="non-scaling-stroke"
      />
    </svg>
  );
}

const RET_W = 760;
const RET_H = 190;
const RET_PAD_X = 30;
const RET_TOP = 40;
const RET_BOTTOM = 26;

function retentionPoints(values: number[]) {
