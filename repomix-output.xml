                        changeRange(r);
                        setMenuOpen(false);
                      }}
                    >
                      {RANGE_LABEL[r]}
                    </button>
                  </li>
                ))}
              </ul>
            )}
          </div>
          <button type="button" className="cm-btn cm-btn-dark" onClick={act('export-ai')}>
            <IconArrow /> Exportar con IA
          </button>
        </div>
