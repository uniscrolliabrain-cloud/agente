export const runDocker: DockerRunner = (args, options) =>
  new Promise((resolve) => {
    const limit = Math.min(options.maxOutputBytes ?? outputLimit, 15 * 1024 * 1024);
    const result: DockerResult = {
      stdout: "",
      stderr: "",
      exitCode: null,
      timedOut: false,
      interrupted: false,
      truncated: false,
