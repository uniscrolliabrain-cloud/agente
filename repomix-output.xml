      else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.trim()))
        errors.email = "El email no tiene un formato valido";
      if (!password) errors.password = "La contrasena es obligatoria";
      else if (password.length < 8)
