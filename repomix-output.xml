```

**`$new`:**
```
export async function withTenantRls<T>(
  store: Store,
  tenantId: string,
  fn: () => Promise<T>,
): Promise<T> {
  if (store.backend !== "postgres" || process.env.MULTI_TENANT_SHARED !== "true") {
    return fn();
  }
  // TENANT_RLS_TX_V1 — antes set_config se hacía fuera de transacción; la
  // siguiente query podía ir por otra conexión del pool y RLS bloqueaba o
  // filtraba mal. Ahora todo va dentro de store.transaction(...), que
  // garantiza la misma conexión. El store.transaction() ya hace BEGIN/COMMIT
  // y, si fn() lanza, ROLLBACK.
  return store.transaction(async () => {
    await store.select("SELECT set_config('app.tenant_id', $1, true)", [tenantId]);
    return fn();
  });
}
```

**Verificación pre:** ancla 1×, marca 0×. Post: marca 1×, `store.transaction` presente, `set_config` dentro.

