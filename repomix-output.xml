  // APP_TENANT_REQUEST_VALIDATE_BODY_V1 — helper para validar tenantId de body
  // contra el tenantId real del owner. Si el body trae tenantId y no coincide,
  // 403 con X-Tenant-Mismatch. Si no trae, no-op. Se usa desde los handlers
  // que aceptan tenantId en el body (crear tarea, thread, ingest RAG, etc.).
  // El helper no toca el body; solo mira y lanza.
  async function validateTenantInBody(
    owner: string,
    body: unknown,
    where: string,
    tenantService: { tenantIdFor: (o: string) => Promise<string> },
  ): Promise<void> {
    if (!body || typeof body !== "object") return;
    const b = body as { tenantId?: unknown };
    if (typeof b.tenantId !== "string") return;
    const expected = await tenantService.tenantIdFor(owner).catch(() => undefined);
    if (!expected) return; // sin tenantService resuelto, no bloqueamos
    if (b.tenantId !== expected) {
      // TENANT_CROSS_AUDIT_V1 — log estructurado del intento cross-tenant.
      // Va por logWarn para que aparezca en logs aunque no haya error 500.
      // Se hace aquí (y no en app.onError) para tener el "where" exacto.
      const crossMsg =
        "TENANT_MISMATCH " + where + ": owner=" + owner + " expected=" + expected + " received=" + b.tenantId;
      // Import dinámico para no acoplar app.ts a log.ts en el módulo raíz.
      void import("./log.ts").then(({ logWarn }) => {
        logWarn("http.cross_tenant_attempt", {
          where,
          owner,
          expectedTenant: expected,
          receivedTenant: b.tenantId,
        });
      }).catch(() => {});
      throw new AppError(crossMsg, 403);
    }
  }

  // KERNEL_STORE_TURN_PERSISTENT_TOGGLE_V1
export async function createApp(
```

