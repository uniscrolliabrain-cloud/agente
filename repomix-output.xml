): Promise<T> {
```

Y en el cuerpo, donde escribe:
```typescript
  // WITH_WRITE_CAS_V1 — CAS si el record declara version.
  const record = await db.get<T>(ctx.owner, kind, id);
  if (!record) throw new AppError("Not found", 404);
  const hasVersion = typeof (record as { version?: unknown }).version === "number";
  if (hasVersion && expectedVersion !== undefined) {
    const updated = await db.compareAndSwap<T>(
      ctx.owner, kind, id,
      { version: expectedVersion },
      { ...next, version: expectedVersion + 1 },
    );
    if (!updated) {
      const current = await db.get<T>(ctx.owner, kind, id);
      const diff = computeDiff(record, current);
      throw new AppError("Conflict", 409, {
        conflict: true,
        current: (current as { version?: number }).version,
        expected: expectedVersion,
        diff,
      });
    }
    return updated;
  }
  // Sin version: put normal (comportamiento actual).
  return db.put(ctx.owner, kind, next);
```

`computeDiff` es una función local que compara campo a campo y devuelve `{ field: { before, after } }`.

