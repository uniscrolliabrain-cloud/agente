**`$new`:**
```
export class BrowserService {
  constructor(
    private readonly db: Store,
    private readonly config: Config,
    private readonly auth: Auth,
    private readonly files: Files,
    // TAKE_FOR_TENANT_BROWSER_V1 — limiter compartido con chat/RAG/threads.
    // Si no se pasa (tests existentes), no hay rate limit y todo funciona
    // como antes.
    private readonly limiter?: RateLimiter,
    // TAKE_FOR_TENANT_TENANTID_V1 — tenantService para resolver el tenantId
    // real del owner. Si no se pasa, se usa "default".
    private readonly tenantService?: { tenantIdFor: (o: string) => Promise<string> },
  ) {}

  // TAKE_FOR_TENANT_BROWSER_V1 — helper común para los 3 call sites.
  private async checkTenantRate(owner: string, action: string): Promise<void> {
    if (!this.limiter) return;
    const tenantId = this.tenantService
      ? await this.tenantService.tenantIdFor(owner).catch(() => "default")
      : "default";
    const verdict = this.limiter.takeForTenant(tenantId, owner, action);
    if (!verdict.allowed) {
      const retrySec = Math.max(1, Math.ceil(verdict.retryAfterMs / 1000));
      const err = new Error(
        "TAKE_FOR_TENANT_BROWSER_V1: límite alcanzado para " + action + ". Reintenta en " + retrySec + "s.",
      ) as Error & { status?: number; retryAfter?: number };
      err.status = 429;
      err.retryAfter = retrySec;
      throw err;
    }
  }
```

