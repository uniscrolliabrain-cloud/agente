  --border-strong: #e2dfdb;
  --text: #18181b;
  --text-2: #71717a;
  --text-3: #a1a1aa;
  --accent: #5b4bdb;
  --accent-soft: #eeebfc;
  --accent-border: #c9c0f4;
  --accent-fg: #ffffff;
  --ok: #15803d;
  --green: #16a36a;
  --warn: #b45309;
  --amber: #c98913;
  --danger: #b91c1c;
  --red: #dc4c4c;
  --blue: #3978e8;
  --danger-bg: #fef2f2;
  --danger-border: #fecaca;
  --font: "Instrument Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
  --fs-xs: 12px;
  --fs-sm: 13px;
  --fs-md: 15px;
  --fs-xl: 30px;
  --r-sm: 8px;
  --r-md: 14px;
  --r-lg: 20px;
  --r-pill: 999px;
  --radius-xs: 6px;
  --radius-sm: 9px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 20px;
  --sidebar-w: 260px;
  --panel-w: 340px;
  --topbar-h: 48px;
  --content-w: 720px;
  --shadow-xs: 0 1px 2px rgba(0, 0, 0, 0.04);
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.04), 0 4px 12px rgba(0, 0, 0, 0.035);
  --shadow-composer: 0 1px 2px rgba(28,25,23,.04), 0 8px 24px rgba(28,25,23,.04);
  --transition: 150ms ease;
  --t: 150ms ease-out;

  /* ---- surface aliases ---- */
  --surface: var(--bg);
  --surface-2: var(--bg-hover);
  --surface-3: var(--bg-active);
}

html[data-theme="dark"] {
  --bg: #171514;
  --bg-sidebar: #1c1a19;
  --bg-hover: #262321;
  --bg-active: #2e2a28;
  --bg-input: #1c1a19;
  --border: #292b31;
  --border-soft: #22242a;
  --border-strong: #3a3633;
  --text: #f4f4f5;
  --text-2: #a1a1aa;
  --text-3: #71717a;
  --accent: #8179ff;
  --accent-soft: #1d1a35;
  --accent-border: #393568;
  --ok: #4ade80;
  --warn: #fbbf24;
  --danger: #f87171;
  --danger-bg: #2a1616;
  --danger-border: #5c2323;
  --shadow-composer: 0 1px 2px rgba(0,0,0,.3), 0 8px 24px rgba(0,0,0,.3);
}

* { box-sizing: border-box; }
html, body, #root { width: 100%; height: 100%; }
html { color-scheme: light; }
html[data-theme="dark"] { color-scheme: dark; }
body {
  margin: 0;
  font-family: var(--font);
  background: var(--bg);
  color: var(--text);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}
button, input, textarea { font: inherit; }
button { color: inherit; }
button:focus-visible, textarea:focus-visible, input:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

/* FIX_BUG1_HAMBURGER_NO_WEB - Doble hamburger que tapa el botón + Nuevo */
.shell__toggles { display: none !important; }
.shell__toggle--mobile { display: none; }

/* Asegura que el TopBar siempre esté por encima */
.v2-topbar { position: relative; z-index: 2; background: var(--bg); }
.v2-topbar-right { position: relative; z-index: 3; }

/* Bug 1: Doble hamburger que tapa el botón + Nuevo */
.shell__toggles { display: none !important; }
.shell__toggle { display: none; }

/* Bug 2: Sidebar deja hueco blanco a la izquierda en <900px */
@media (max-width: 900px) {
  .shell, .shell[data-left="true"], .shell[data-left="false"] {
    grid-template-columns: 0 1fr 0 !important;
  }
  .shell__left {
    position: fixed; inset: 0 auto 0 0; width: 260px; z-index: 50;
    background: #F3F0EB; box-shadow: 12px 0 40px rgba(0,0,0,.15);
    transform: translateX(-100%); transition: transform 250ms ease;
  }
  .shell[data-left="true"] .shell__left { transform: translateX(0); }
  .v2-sidebar { display: flex !important; width: 100% !important; height: 100%; }
  .shell__toggle--mobile {
    display: grid; place-items: center;
    position: absolute; top: 12px; left: 12px; z-index: 5;
    width: 32px; height: 32px; border: 1px solid var(--border);
    border-radius: 8px; background: #FFF;
  }
  .v2-topbar { padding-left: 56px; }
}

/* Bug 3: Sidebar no ocupa el ancho reservado (40px blanco en desktop) */
.v2-sidebar { width: 100%; }
.brand-mark {
  width: 30px; height: 30px; display: grid; place-items: center;
  border-radius: 9px;
  background: linear-gradient(135deg, #655df7, #8278ff);
