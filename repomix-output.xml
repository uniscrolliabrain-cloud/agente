## 7. Plantilla completa (fix + atómico + verde + audit)

```powershell
cd "C:\Users\Alfonso\Desktop\git hub repos\agente"

# --- Configuración del patchset ---
$file  = "ruta/relativa/al/fichero.ext"
$mark  = "MARCA_UNICA_V1"
$pkg   = "@openmuse/server"
$auditDir = (Get-Location).Path

# --- Comprobación previa ---
if (-not (Test-Path $file)) {
  Write-Host "ERROR: $file no existe" -ForegroundColor Red
  exit 1
}

$content = Get-Content $file -Raw

if ($content -match $mark) {
  Write-Host "SKIP: $mark ya aplicado" -ForegroundColor DarkGray
  exit 0
}

# --- Preparar contenido nuevo ---
$lines = @(
  '// MARCA_UNICA_V1',
  '',
  '// contenido...',
  ''
)
$newContent = $lines -join "`r`n"

# --- Escritura atómica ---
$dir = Split-Path $file -Parent
$tmp = Join-Path $dir ("." + (Split-Path $file -Leaf) + ".tmp")

[System.IO.File]::WriteAllText(
  (Join-Path (Get-Location) $tmp),
  $newContent,
  (New-Object System.Text.UTF8Encoding $false)
)

Move-Item -Force $tmp $file
Write-Host "OK escritura atomica: $file" -ForegroundColor Green

# --- Verificación en verde ---
$out = "typecheck-$($pkg -replace '[^a-zA-Z0-9]','_').txt"
pnpm --filter $pkg exec tsc --noEmit 2>&1 | Tee-Object -FilePath $out

if ($LASTEXITCODE -ne 0) {
  Write-Host "FALLO: typecheck no pasa en $pkg" -ForegroundColor Red

  # --- Audit de fallos ---
  $stamp = Get-Date -Format "yyyyMMdd-HHmmss"
  $auditFile = Join-Path $auditDir "audit-fallos-$stamp.md"

  $auditLines = @(
    "# Audit de fallos",
    "",
    "- Fecha: $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')",
    "- Carpeta de lanzamiento: $auditDir",
    "- Comando: pnpm --filter $pkg exec tsc --noEmit",
    "- Ámbito: $pkg",
    "- Fichero: $file",
    "- Marca: $mark",
    "- Salida: $out",
    "",
    "## Fallos",
    "",
    "- typecheck falla en $pkg",
    "- ver $out para detalle",
    "",
    "FIN DEL AUDIT.",
    ""
  )

  [System.IO.File]::WriteAllText(
    $auditFile,
    ($auditLines -join "`r`n"),
    (New-Object System.Text.UTF8Encoding $false)
  )
  Write-Host "AUDIT: $auditFile" -ForegroundColor Yellow
  exit 1
}

Write-Host "OK verde: $pkg" -ForegroundColor Green
```

