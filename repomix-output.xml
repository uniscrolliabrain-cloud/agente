// fila falla, se hace ROLLBACK y no queda estado intermedio. Antes cada
// UPDATE iba por separado; un fallo a mitad dejaba owners migrados y otros
// no, y el siguiente arranque no sabía qué había pasado.
import { createStore } from "../apps/server/src/db.ts";

async function main() {
