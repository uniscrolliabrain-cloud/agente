  { name: "tests", cmd: "pnpm test", fatal: true },
  { name: "tenant-isolation", cmd: "pnpm exec tsx --test tests/tenant-isolation.test.ts", fatal: true },
  { name: "guardrails", cmd: "pnpm exec tsx --test tests/guardrails.test.ts", fatal: true },
