}
.sidebar.collapsed { width: 0; flex-basis: 0; overflow: hidden; opacity: 0; pointer-events: none; }
.sidebar-top { display: flex; flex-direction: column; gap: 6px; padding: 13px 11px 8px; }
.new-chat-button, .sidebar-search {
