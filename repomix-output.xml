): AgentTask {
  const created = new Date(Date.now() - minutesAgo * 60_000).toISOString();
  const updated = new Date(Date.now() - (minutesAgo - 1) * 60_000).toISOString();
  return {
    id,
    tenantId: "default",
    title: `Task ${id}`,
    prompt: "x",
    kind: "agent",
    status,
    plan: [],
    evidence: [],
    input: {},
    state: { roleId: personaId },
    createdAt: created,
    updatedAt: updated,
    attempts: 0,
    leaseId: null,
    leaseUntil: null,
    artifactIds: [],
    assignedTo: personaId,
  };
}

