  gap: 12px;
  padding: 0 0 18px;
  color: var(--text-3);
}
.tl__step::after {
  content: "";
  position: absolute;
  left: 10px;
  top: 24px;
  bottom: 0;
  width: 2px;
  background: var(--border);
}
.tl__step:last-child::after { display: none; }
.tl__dot {
  width: 22px;
  height: 22px;
  border-radius: 999px;
  border: 2px solid var(--border);
  background: var(--surface);
