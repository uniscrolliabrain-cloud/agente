/** apply() aplica el cambio local y devuelve cómo deshacerlo. */
export async function optimistic<T>(
  apply: () => () => void,
  request: () => Promise<T>,
  onFail?: (e: unknown) => void,
): Promise<T | undefined> {
  const rollback = apply();
  try { return await request(); }
  catch (e) { rollback(); onFail?.(e); return undefined; }
}

