<file path="apps/web/src/index.css">
@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;650;700&display=swap");

:root {
  --bg: #ffffff;
  --bg-sidebar: #fafaf9;
  --bg-hover: #f3f1ee;
  --bg-active: #eeece9;
  --bg-input: #ffffff;
