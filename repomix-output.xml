}

/* B1_SHELL_CSS_V1 - shell 3 columnas plegables. */
.shell {
  display: grid;
  height: 100vh;
  grid-template-columns: 0 1fr 0;
  transition: grid-template-columns 280ms cubic-bezier(.22, 1, .36, 1);
}
.shell[data-left="true"] { grid-template-columns: 260px 1fr 0; }
