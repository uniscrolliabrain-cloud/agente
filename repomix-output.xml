            </button>
            {menuOpen && (
              <ul className="cm-menu" role="listbox">
                {RANGES.map((r) => (
                  <li key={r} role="option" aria-selected={r === range}>
                    <button
                      type="button"
                      className={r === range ? 'is-active' : ''}
