### Patchset F3.4 — `apps/server/src/engine/assignments/registry.ts` (CREATE)

**Marca:** `ASSIGNMENT_REGISTRY_V1`

**Contenido:**

```typescript
// ASSIGNMENT_REGISTRY_V1 — Map<AssignmentKind, AssignmentAdapter>.
import type { AssignmentKind } from "../../../../../packages/domain/src/assignment.ts";

export interface AssignmentAdapter<TRecord = unknown> {
  readonly kind: AssignmentKind;
  toAssignment(record: TRecord): import("../../../../../packages/domain/src/assignment.ts").Assignment;
  applyAssignment(record: TRecord, changes: Partial<import("../../../../../packages/domain/src/assignment.ts").Assignment>): TRecord;
  applyStatus(record: TRecord, status: import("../../../../../packages/domain/src/assignment.ts").AssignmentStatus): TRecord;
}

export class AssignmentRegistry {
  private readonly adapters = new Map<AssignmentKind, AssignmentAdapter>();

  register(adapter: AssignmentAdapter): void {
    if (this.adapters.has(adapter.kind)) {
      throw new Error(`AssignmentAdapter already registered for kind ${adapter.kind}`);
    }
    this.adapters.set(adapter.kind, adapter);
  }

  get(kind: AssignmentKind): AssignmentAdapter {
    const adapter = this.adapters.get(kind);
    if (!adapter) throw new Error(`No AssignmentAdapter registered for kind ${kind}`);
    return adapter;
  }

  has(kind: AssignmentKind): boolean {
    return this.adapters.has(kind);
  }
}
```

