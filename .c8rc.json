{
  "all": true,
  "include": [
    "apps/server/src/**/*.ts",
    "apps/worker/src/**/*.ts",
    "packages/domain/src/**/*.ts",
    "packages/integrations/src/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/dist/**",
    "**/node_modules/**",
    "apps/server/src/demo/**",
    "apps/server/src/kernel/cromos/**"
  ],
  "reporter": ["text", "text-summary", "json-summary", "lcov"],
  "report-dir": "coverage",
  "temp-directory": "coverage/.tmp",
  "check-coverage": false,
  "lines": 50,
  "functions": 50,
  "branches": 40,
  "statements": 50
}
