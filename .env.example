# Copy this file to .env and fill in real values. .env is gitignored; never commit real keys.
WORKSPACE_MODE=sample
AGENT_BACKEND=model
PORT=8787
HOST=127.0.0.1
PUBLIC_API_URL=http://127.0.0.1:8787
DATA_DIR=.openmuse
COMPUTER_ENABLED=false
COMPUTER_IMAGE=openmuse-computer:local
DATABASE_URL=

# --- Primer administrador (huevo y gallina) ----------------------------------
# Sin usuarios en la DB nadie puede entrar: los usuarios solo los crea un admin y el
# primer admin sale de aqui. Rellena estas tres (o ejecuta "pnpm admin:create" una vez
# con el API parado) antes del primer arranque; si se dejan vacias el login devuelve 401.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# --- Model providers ---------------------------------------------------------
# MODEL is a "<provider>/<model>" specifier. Supported providers: openai, anthropic,
# google (gemini), google-gemini, minimax, vertex.
# Gemini is used as the primary provider; OpenRouter is the fallback.
MODEL=google/gemini-3.6-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# The fallback runs through OpenRouter's OpenAI-compatible endpoint, so it is addressed as
# "openai/<openrouter-model-id>"; config.ts sets OPENAI_API_KEY/OPENAI_BASE_URL from these.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.6-flash
# Optional explicit fallback. Defaults to "openai/$OPENROUTER_MODEL" when OPENROUTER_API_KEY is set.
MODEL_FALLBACK=
# Native OpenAI or another OpenAI-compatible gateway instead of OpenRouter:
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Google OAuth: Gmail, Calendar, Drive ------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Live mode requires a 32-byte base64 key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Live mode also requires an access key of at least 24 characters.
OPENMUSE_ACCESS_KEY=
# The server derives the OAuth redirect from PUBLIC_API_URL + /api/google/callback and it must be
# registered verbatim in the Google Cloud console for the same OAuth client.

# --- Optional: durable Postgres instead of the embedded PGlite store ---------
# DATABASE_URL=postgres://user:password@host:5432/openmuse
# The business queries of the SOPs (tool "query_business") run against BUSINESS_DATABASE_URL
# when it is set, and against DATABASE_URL otherwise. It should be a SEPARATE database and a
# read-only role: the query arrives already interpolated from the SOP, so there is no per-owner
# filter. Without this separation a SELECT * FROM records would return every owner's rows.
#   CREATE ROLE openmuse_ro LOGIN PASSWORD '...';
#   GRANT CONNECT ON DATABASE negocio TO openmuse_ro;
#   GRANT USAGE ON SCHEMA public TO openmuse_ro;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO openmuse_ro;
#   BUSINESS_DATABASE_URL=postgres://openmuse_ro:...@host:5432/negocio
BUSINESS_DATABASE_URL=
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# --- Browser worker (optional; see apps/worker/README.md) --------------------
# BROWSER_WORKER_URL must be loopback when the worker runs on the host.
# WORKER_TOKEN must be at least 32 characters and match the worker process.
BROWSER_WORKER_URL=http://127.0.0.1:8790
WORKER_TOKEN=

# --- Task worker ------------------------------------------------------------
# Set to "false" to embed the task worker inside the API process (embedded PGlite).
TASK_WORKER_ENABLED=true

# --- Computer (optional) ----------------------------------------------------
# Stable per-deployment identifier. Changing it provisions a fresh sandbox.
COMPUTER_DEPLOYMENT_ID=

# --- Backups automaticos -----------------------------------------------------
# Cada cuantas horas se hace un backup. 0 = desactivado.
BACKUP_INTERVAL_HOURS=24
# Cuantos dias se conservan los backups antiguos antes de borrarlos. 0 = no borrar nunca.
BACKUP_RETENTION_DAYS=7