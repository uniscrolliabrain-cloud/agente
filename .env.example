# Copy this file to .env and fill in real values. .env is gitignored; never commit real keys.
WORKSPACE_MODE=sample
AGENT_BACKEND=model
PORT=8787
HOST=127.0.0.1
PUBLIC_API_URL=http://127.0.0.1:8787
DATA_DIR=.agente
COMPUTER_ENABLED=false
COMPUTER_IMAGE=agente-computer:local
DATABASE_URL=

# --- Primer administrador (huevo y gallina) ----------------------------------
# Sin usuarios en la DB nadie puede entrar: los usuarios solo los crea un admin y el
# primer admin sale de aqui. Rellena estas tres (o ejecuta "pnpm admin:create" una vez
# con el API parado) antes del primer arranque; si se dejan vacias el login devuelve 401.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# --- Model providers ---------------------------------------------------------
# MODEL is a "<provider>/<model>" specifier. Supported providers: openai, anthropic,
# google (gemini), google-gemini, minimax, vertex.
# Gemini is used as the primary provider; OpenRouter is the fallback.
MODEL=google/gemini-3.6-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# The fallback runs through OpenRouter's OpenAI-compatible endpoint, so it is addressed as
# "openai/<openrouter-model-id>"; config.ts sets OPENAI_API_KEY/OPENAI_BASE_URL from these.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.6-flash
# Optional explicit fallback. Defaults to "openai/$OPENROUTER_MODEL" when OPENROUTER_API_KEY is set.
MODEL_FALLBACK=
# Native OpenAI or another OpenAI-compatible gateway instead of OpenRouter:
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Google OAuth: Gmail, Calendar, Drive ------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Live mode requires a 32-byte base64 key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Live mode also requires an access key of at least 24 characters.
AGENTE_ACCESS_KEY=
# The server derives the OAuth redirect from PUBLIC_API_URL + /api/google/callback and it must be
# registered verbatim in the Google Cloud console for the same OAuth client.

# --- Optional: durable Postgres instead of the embedded PGlite store ---------
# DATABASE_URL=postgres://user:password@host:5432/agente
# The business queries of the SOPs (tool "query_business") run against BUSINESS_DATABASE_URL
# when it is set, and against DATABASE_URL otherwise. It should be a SEPARATE database and a
# read-only role: the query arrives already interpolated from the SOP, so there is no per-owner
# filter. Without this separation a SELECT * FROM records would return every owner's rows.
#   CREATE ROLE agente_ro LOGIN PASSWORD '...';
#   GRANT CONNECT ON DATABASE negocio TO agente_ro;
#   GRANT USAGE ON SCHEMA public TO agente_ro;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO agente_ro;
#   BUSINESS_DATABASE_URL=postgres://agente_ro:...@host:5432/negocio
BUSINESS_DATABASE_URL=
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# --- Browser worker (optional; see apps/worker/README.md) --------------------
# BROWSER_WORKER_URL must be loopback when the worker runs on the host.
# WORKER_TOKEN must be at least 32 characters and match the worker process.
BROWSER_WORKER_URL=http://127.0.0.1:8790
WORKER_TOKEN=

# --- Task worker ------------------------------------------------------------
# Set to "false" to embed the task worker inside the API process (embedded PGlite).
TASK_WORKER_ENABLED=true

# --- Computer (optional) ----------------------------------------------------
# Stable per-deployment identifier. Changing it provisions a fresh sandbox.
COMPUTER_DEPLOYMENT_ID=

# --- Backups automaticos -----------------------------------------------------
# Cada cuantas horas se hace un backup. 0 = desactivado.
BACKUP_INTERVAL_HOURS=24
# Cuantos dias se conservan los backups antiguos antes de borrarlos. 0 = no borrar nunca.
BACKUP_RETENTION_DAYS=7
# --- Kernel LLM: dos velocidades ---------------------------------------------
# Dos API keys de Google para cuotas separadas. Mismo modelo gemini-3.6-flash.
# FAST: habla con el usuario (chat, respuestas rapidas, tools triviales).
# SLOW: razona en background (tareas, SOPs, planificacion).
FAST_LLM_PROVIDER=google
FAST_LLM_MODEL=gemini-3.6-flash
FAST_LLM_API_KEY=

SLOW_LLM_PROVIDER=google
SLOW_LLM_MODEL=gemini-3.6-flash
SLOW_LLM_API_KEY=

EMBEDDINGS_LLM_PROVIDER=google
EMBEDDINGS_LLM_MODEL=text-embedding-004
EMBEDDINGS_LLM_API_KEY=
# --- Multi-proceso (opcional) -----------------------------------------------
# api    = solo HTTP, sin worker embebido (worker en otro proceso).
# worker = solo worker, sin HTTP (ver apps/server/src/worker-entry.ts).
# all    = todo en uno (por defecto, comportamiento previo).
AGENTE_PROCESS_ROLE=all

# --- Auth multitenant con JWT (Supabase) -------------------------------------
# AUTH_PROVIDER=supabase activa verifyJwtMiddleware: la firma del token se
# verifica de verdad (JWKS/asimetrica o HS256) y el tenant sale del claim.
# Sin claim de tenant la peticion es 401; con un tenant del que el usuario no es
# miembro es 403. Los valores reales van en Doppler, no aqui.
AUTH_PROVIDER=session
SUPABASE_URL=
# Solo si el proyecto firma con HS256. Si hay SUPABASE_URL, se usa la JWKS y
# esta variable se ignora.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUD=authenticated

# --- Conexiones --------------------------------------------------------------
# Los valores reales viven en Doppler. `pnpm connections --probe` dice cual falta,
# con que nombre lo publica Doppler y si responde. Nada de esto se imprime.
#
# Doppler puede publicar los secretos con el nombre del proveedor: el arranque
# normaliza los alias (WHATSAPP_ACCESS_TOKEN -> WHATSAPP_TOKEN,
# WHATSAPP_PHONE_NUMBER_ID -> WHATSAPP_PHONE_ID) para no duplicar variables.

# --- Email transaccional ------------------------------------------------------
RESEND_API_KEY=
# Debe ser de un dominio verificado en Resend o la API rechaza el envio.
EMAIL_FROM=

# --- Canales (campana canales; sin key el adaptador responde 503 honesto) -----
# Meta WhatsApp Cloud API. El webhook exige WHATSAPP_APP_SECRET para validar
# X-Hub-Signature-256; sin el, cualquiera podria inyectar mensajes.
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_ID=
# Version de Graph API; por defecto v21.0.
WHATSAPP_GRAPH_VERSION=v21.0
# Operator-owned routing. Use a dedicated primary execution owner per tenant.
# No credentials in this JSON; secretEnv names a secret stored in Doppler/env.
# WHATSAPP_WEBHOOK_BINDINGS=[{"provider":"meta","accountId":"PHONE_NUMBER_ID","tenantId":"agntia","owner":"OWNER_ID","sopId":"SOP_ID"},{"provider":"evolution","accountId":"INSTANCE_NAME","tenantId":"agntia","owner":"OWNER_ID","sopId":"SOP_ID","secretEnv":"WHATSAPP_AGNTIA_INBOUND_SECRET"}]
WHATSAPP_WEBHOOK_BINDINGS=[]
# Evolution: configure this value as the instance's x-webhook-secret header.
# It must contain at least 32 random characters; do not reuse the Meta verify token.
WHATSAPP_AGNTIA_INBOUND_SECRET=
# Voz (Vapi): agente que atiende llamadas.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
# Numero emisor de la cuenta; si falta, Vapi usa el del asistente.
VAPI_PHONE_NUMBER_ID=
# La voz saliente queda apagada hasta que esto sea true: una llamada real gasta dinero.
VOICE_OUTBOUND_ENABLED=false
# Cobros
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Leads locales
GOOGLE_MAPS_API_KEY=

# =============================================================================
# Variables que el codigo lee y que antes no estaban documentadas aqui.
# Las que van comentadas conservan el valor por defecto del codigo: se dejan
# asi para que copiar este fichero no cambie el comportamiento.
# =============================================================================

# --- Trazabilidad y politicas (apps/server/src/config.ts) ---------------------
# AUDIT_TRAIL_ENABLED=false apaga el rastro de auditoria; por defecto va activo.
AUDIT_TRAIL_ENABLED=true
# RECORD_HISTORY_ENABLED=true guarda el historial de cambios de cada registro.
RECORD_HISTORY_ENABLED=false
# En modo sample se pueden apagar; en live van siempre activas.
AUTHZ_ENABLED=true
FIELD_CLASSIFICATION_ENABLED=true
# TTL de la cache de politicas PDP, en ms.
POLICY_CACHE_TTL_MS=60000
# TTL de la sesion del panel, en ms (apps/server/src/auth.ts).
# SESSION_TTL_MS=1800000
# Espera maxima a drenar peticiones al apagar, en ms (index.ts).
# SHUTDOWN_DRAIN_MS=10000
# Log estructurado: nivel y muestreo (log.ts).
LOG_LEVEL=info
# LOG_SAMPLE_RATE=0.1
# Telemetria de terceros: config.ts la apaga si no se define.
DO_NOT_TRACK=1
COPILOTKIT_TELEMETRY_DISABLED=true
# Carpeta de clientes y backend del store del kernel.
# AGENTE_CLIENTS_DIR=clientes
# AGENTE_KERNEL_STORE=
# Agente externo (backend AGUI) y su token.
# AGENT_URL=
# AGENT_TOKEN=
# true si un solo proceso atiende varios tenants compartiendo cache y store.
# MULTI_TENANT_SHARED=false
# Token del endpoint de metricas (metrics-exporter.ts).
# METRICS_TOKEN=

# --- Timeouts por herramienta (config.ts, toolTimeouts) -----------------------
# Valores por defecto del codigo; se ajustan sin redeploy.
# LLM_FIRST_BYTE_MS=45000
# LLM_GLOBAL_MS=120000
# GOOGLE_HTTP_MS=30000
# COMPUTER_COMMAND_MS=30000
# COMPUTER_CLIENT_MS=35000
# WHATSAPP_SEND_MS=20000
# STRIPE_HTTP_MS=20000
# BROWSER_NAV_MS=20000

# --- Cuotas, aprobaciones y coste --------------------------------------------
# Llamadas por hora y velocidad (config.ts, quotaPerSpeed).
# FAST_CALLS_PER_HOUR=600
# SLOW_CALLS_PER_HOUR=60
# Ventana para deshacer una aprobacion, en ms, e importe a partir del cual se
# exige doble firma (vacio = nunca).
# DEFERRED_ACTION_WINDOW_MS=8000
# DEFERRED_ACTION_DUAL_AT=
# Caducidad de una accion propuesta, en ms (actions.ts).
# ACTION_EXPIRES_MS=900000
# Tiempo tras el que un resultado ambiguo se marca como atascado (service.ts).
# OUTCOME_UNKNOWN_STUCK_MS=900000
# Coste estimado por 1k tokens para el resumen de uso (service.ts).
# LLM_COST_EUR_PER_1K_TOKENS=0.0002
# Peticiones simultaneas por proveedor antes de hacer cola (model-chain.ts).
# LLM_BULKHEAD_PER_PROVIDER=4

# --- Chat, contexto y memoria -------------------------------------------------
# Pasos maximos por turno del agente (conversation.ts).
# AGENT_MAX_STEPS=8
# Timeout de un turno de chat, en ms.
# CHAT_TIMEOUT_MS=120000
# Limites de correo y de historial RAG que entran en el prompt.
# CHAT_MAIL_LIMIT=5
# CHAT_RAG_HISTORY=5
# Eventos maximos que el ContextEngine mete en el paquete (context/engine.ts).
# CONTEXT_EVENT_LIMIT=20
# TTL de los hechos aprendidos, en ms.
# LEARNING_FACTS_TTL_MS=2592000000

# --- RAG (engine/rag.ts) ------------------------------------------------------
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=120
# RAG_MAX_CHUNKS_PER_SOURCE=200
# RAG_SEARCH_PAGE_SIZE=20
# RAG_VECTOR_DIMENSIONS=768

# --- Worker, leases y bus de eventos -----------------------------------------
# TASK_TIMEOUT_MS=300000
# WORKER_DRAIN_TIMEOUT_MS=15000
# WORKER_GUARD_CACHE_MS=5000
# WORKER_LEASE_MS=60000
# WORKER_MAX_ACTIVE=4
# WORKER_MAX_PER_OWNER=2
# Host y carpeta de datos del worker de navegador.
# WORKER_HOST=127.0.0.1
# WORKER_DATA_DIR=.agente/worker
# Dedupe del bus de eventos: TTL y tamano de la LRU.
# EVENTBUS_DEDUPE_TTL_MS=600000
# EVENTBUS_DEDUPE_LRU=5000
# TTL de la cache de tenant en rutas y en el resolutor de config del kernel.
# TENANT_CACHE_TTL_MS=300000
# TENANT_CONFIG_TTL_MS=300000
# Entradas maximas del listado de auditoria del kernel.
# KERNEL_AUDIT_MAX_LIST=200

# --- Alta de usuarios y OAuth de GitHub ---------------------------------------
# SIGNUP_ENABLED=true abre el alta publica; VERIFY_TTL_HOURS es la validez del
# enlace de verificacion. OAUTH_ALLOWED_EMAILS limita quien puede entrar con OAuth.
# SIGNUP_ENABLED=false
# VERIFY_TTL_HOURS=48
# OAUTH_ALLOWED_EMAILS=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Proveedores de modelo adicionales ---------------------------------------
# Anthropic directo (agent.ts); Google y las bases URL de los tres carriles LLM.
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# FAST_LLM_BASE_URL=
# SLOW_LLM_BASE_URL=
# EMBEDDINGS_LLM_BASE_URL=

# --- WhatsApp (Evolution/Meta) y Google Business ------------------------------
# WHATSAPP_ACCESS_TOKEN es el alias que publica Doppler para WHATSAPP_TOKEN.
# WHATSAPP_OUTBOUND_ENABLED=false deja el envio apagado hasta que se active.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_API_KEY=
# WHATSAPP_BASE_URL=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_INSTANCE=
# WHATSAPP_OUTBOUND_ENABLED=false
# WHATSAPP_WEBHOOK_TOKEN=
# WHATSAPP_PROVISION_API_KEY=
# GMB_API_KEY=
# GMB_CLIENT_ID=

# --- Modo demo (apps/server/src/demo/entry.ts) --------------------------------
# Levanta un servidor de demostracion con latencias simuladas del modelo.
# DEMO_ALLOWED_ORIGINS=
# DEMO_API_PORT=8799
# DEMO_MODEL_CHUNK_DELAY_MS=40
# DEMO_MODEL_FIRST_BYTE_DELAY_MS=300
# DEMO_WORKER_TOKEN=
# DEMO_WORKER_URL=

# --- Scripts operativos -------------------------------------------------------
# Doppler (scripts/connections.ts y provision), semillas y smokes.
# DOPPLER_PROJECT=
# DOPPLER_TOKEN=
# AGENTE_EMAIL=
# AGENTE_PASSWORD=
# AGENTE_URL=
# SMOKE_EMAIL=
# SMOKE_PASSWORD=
# SMOKE_TENANT=

# --- Solo tests ---------------------------------------------------------------
# ALLOW_NETWORK=0 bloquea red en la suite; los *_TEST_SECRET y CRASH_* los usan
# los helpers de tests; WORKER_TEST_* apuntan al contenedor de Docker del worker.
# ALLOW_NETWORK=0
# CRASH_TASK_ID=
# CRASH_TASK_OWNER=
# AGENTE_TEST_SECRET=
# WHATSAPP_INBOUND_TEST_SECRET=
# WHATSAPP_REPLY_TEST_SECRET=
# WHATSAPP_TEST_INBOUND_SECRET=
# WORKER_TEST_CONTAINER=
# WORKER_TEST_URL=

# --- Heredadas del sistema ----------------------------------------------------
# HOME, PATH, TMPDIR y TZ las lee el modo demo para construir el entorno del
# proceso; no son configuracion de la app y no se definen aqui salvo TZ, que si
# conviene fijar en produccion para que las fechas de los recibos sean las
# esperadas. Se listan para que el recuento de variables leidas no las trate
# como configuracion sin documentar.
# TZ=Europe/Madrid
# TMPDIR=/tmp
# PATH=/usr/local/bin:/usr/bin:/bin

# --- Voz y cara (scaffold) -------------------------------------------------
# Voz: una clave global y, si quieres voces distintas, una por agente con el id
# en MAYUSCULAS_CON_GUIONES (ELEVENLABS_VOICE_COMERCIAL, ELEVENLABS_VOICE_LEGAL...).
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_flash_v2_5
# Cara: persona de Anam global o por agente (ANAM_PERSONA_LAIA, ANAM_PERSONA_LEGAL...).
# ANAM_API_KEY=
# ANAM_PERSONA_ID=
# Presupuesto de voz: el chat usa 8000 ms de primer byte; voz no puede esperar eso.
# VOICE_FIRST_BYTE_MS=900
# VOICE_TOTAL_MS=20000
# VOICE_CONTEXT_MS=120
# VOICE_SILENCE_MS=45000
# VOICE_MAX_SESSION_MS=900000
# VOICE_EUR_PER_MINUTE=0.12
# VOICE_SNAPSHOT_TTL_MS=600000
# CHAT_CONTEXT_DEADLINE_MS=900
