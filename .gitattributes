# Sin esto, un checkout en Windows deja todo el repo en CRLF y biome marca cada fichero
# entero como fallo de "format" (258 de los errores del audit eran esto, no codigo real).
# Con LF en el indice, el arbol de trabajo se normaliza al hacer checkout y el lint
# compara contenido, no finales de linea.
* text=auto eol=lf

# El lockfile se versiona tal cual sale de pnpm: no renormalizar.
pnpm-lock.yaml -text

# Binarios: los finales de linea no existen para ellos.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg text eol=lf
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.mp3 binary
*.mp4 binary
*.mov binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.wasm binary
*.sqlite binary
*.db binary
