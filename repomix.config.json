{
  "input": {
    "maxFileSize": 20000
  },
  "output": {
    "style": "markdown",
    "filePath": "repomix-output.md"
  },
  "ignore": {
    "customPatterns": [
      "apps/web/**",
      "apps/computer/**",
      "apps/worker/**",
      "**/*.test.ts",
      "**/*.spec.ts",
      "**/tests/**",
      "**/docs/**",
      "**/*.md"
    ]
  }
}
