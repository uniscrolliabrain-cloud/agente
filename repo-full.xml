const upd=()=>{document.querySelectorAll('[data-k]').forEach(el=>{const[id,f]=el.dataset.k.split(':'),i=items.find(x=>x.id==id);if(!i)return;const v=i[f];el.textContent=f==='v'&&i.k==='progress'?v+'%':f==='v'?v:fm(v)});
