  const meta = new Meta({ longNoOutputMs: 30_000 });
  const hints = meta.evaluateWithProgress({
    progress: [readyResult("resultado listo")],
    now: new Date().toISOString(),
    lastFastActivityAt: new Date(Date.now() - 5000).toISOString(),
  });
