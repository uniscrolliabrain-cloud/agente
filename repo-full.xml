                onChange={(e) => setDraft({ ...draft, name: e.target.value })}
                placeholder="Leo"
              />
              <label className="modal-label">Objetivo</label>
              <textarea
                className="v2-pill"
                style={{ width: "100%", padding: "8px 12px", marginBottom: 8, minHeight: 80 }}
                value={draft.objetivo ?? ""}
